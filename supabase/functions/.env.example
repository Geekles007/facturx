# Variables des Edge Functions en local et en CI. `pnpm compte:test` passe supabase/functions/.env
# (copie de ce fichier, non versionnée) à `supabase functions serve --env-file`, ou ce fichier-ci
# quand .env n'existe pas (en CI).

# Les origines admises par CORS, séparées par des virgules : le Studio servi en local. Sans la
# variable, aucune origine n'est admise. En production, l'origine du site (secret du projet).
FACTURX_ORIGINES=http://localhost:8080

# Laisse les tests fixer « aujourd'hui » par l'en-tête x-facturx-aujourdhui (un 31 décembre, un
# 2 janvier). Absente, ou avec toute autre valeur que 1, l'en-tête est ignoré, comme sur un projet
# hébergé par Supabase (*.supabase.co), quelle que soit la valeur.
# JAMAIS EN PRODUCTION, JAMAIS DANS `supabase secrets`.
FACTURX_TESTS=1

# L'envoi des relances (fonction `relancer`). BREVO_API_KEY : la clé de l'API Brevo en production
# (secret du projet, jamais ici) ; `simule` en local et en CI : rien ne part, la réponse est un
# identifiant simule-<uuid>, et chaque message remis au simulateur est déposé en JSON dans le bucket
# `factures`, sous simule/<numéro de facture>/ (les tests le lisent). `simule` est refusé sur un projet
# hébergé par Supabase. Quatre domaines d'adresses règlent les réponses du simulateur, pour les tests :
# refus.test (refus de Brevo : 502), incertain.test (pas de réponse : 201 avec incertain: true),
# lent.test (réponse après 3 secondes) et id-hostile.test (identifiant de message à nettoyer).
# RELANCES_EXPEDITEUR : l'adresse d'expédition, sur le domaine de facturx (relances@…) ; Reply-To est
# l'adresse du compte.
BREVO_API_KEY=simule
RELANCES_EXPEDITEUR=relances@localhost

# Le secret de la fonction `purger` (suppression des comptes échus et des PDF orphelins), envoyé dans
# l'en-tête x-purge-secret ; absent ou vide, la fonction refuse tout (401). La valeur ci-dessous est
# celle des essais locaux et de la CI (`pnpm compte:test` la passe aux tests). En production, un secret
# long et aléatoire, posé deux fois : par `supabase secrets set PURGE_SECRET=…` (la fonction le lit) et
# dans le Vault sous le nom `purger_secret` (la tâche de nuit l'envoie), avec `purger_url` (tâche 23).
PURGE_SECRET=secret-de-purge-pour-les-essais-locaux
