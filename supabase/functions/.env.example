# Variables des Edge Functions en local et en CI. `pnpm compte:test` passe supabase/functions/.env
# (copie de ce fichier, non versionnée) à `supabase functions serve --env-file`, ou ce fichier-ci
# quand .env n'existe pas (en CI).

# Les origines admises par CORS, séparées par des virgules : le Studio servi en local. Sans la
# variable, aucune origine n'est admise. En production, l'origine du site (secret du projet).
FACTURX_ORIGINES=http://localhost:8080

# Laisse les tests fixer « aujourd'hui » par l'en-tête x-facturx-aujourdhui (un 31 décembre, un
# 2 janvier). Absente, ou avec toute autre valeur que 1, l'en-tête est ignoré, comme sur un projet
# hébergé par Supabase (*.supabase.co), quelle que soit la valeur.
# JAMAIS EN PRODUCTION, JAMAIS DANS `supabase secrets`.
FACTURX_TESTS=1

# L'envoi des relances (fonction `relancer`). BREVO_API_KEY : la clé de l'API Brevo en production
# (secret du projet, jamais ici) ; `simule` en local et en CI : rien ne part, la réponse est un
# identifiant simule-<uuid>, et le simulateur refuse les adresses du domaine refus.test. `simule` est
# refusé sur un projet hébergé par Supabase. RELANCES_EXPEDITEUR : l'adresse d'expédition, sur le
# domaine de facturx (relances@…) ; Reply-To est l'adresse du compte.
BREVO_API_KEY=simule
RELANCES_EXPEDITEUR=relances@localhost
