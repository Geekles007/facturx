{
  "name": "facturx-monorepo",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm --filter facturx-sdk typecheck",
    "test": "pnpm --filter facturx-sdk test",
    "build": "pnpm --filter facturx-sdk build",
    "examples:check": "pnpm -r --filter \"./examples/*\" run check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm site:check && pnpm examples:check",
    "bump": "node scripts/bump.mjs",
    "release:check": "node scripts/release-check.mjs",
    "schemas:fetch": "node scripts/fetch-schemas.mjs",
    "rfe:check": "node scripts/check-france-rfe.mjs",
    "samples:fetch": "node scripts/fetch-samples.mjs",
    "validator:fetch": "node scripts/fetch-validator-assets.mjs",
    "downloads:fetch": "node scripts/fetch-npm-downloads.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:dist": "pnpm build && pnpm validator:fetch && pnpm downloads:fetch && pnpm site:build",
    "site:check": "tsc --noEmit -p tsconfig.site.json && vitest run --config vitest.site.config.mts && pnpm site:build",
    "compte:preparer": "node scripts/compte-preparer.mjs",
    "compte:polices": "node scripts/compte-polices.mjs",
    "compte:start": "supabase start",
    "compte:test": "node scripts/compte-test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/libre-baskerville": "^0.4.3",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "facturx-sdk": "workspace:*",
    "fake-indexeddb": "^6.2.7",
    "fflate": "0.8.3",
    "geist": "^1.7.2",
    "pdf-lib": "^1.17.1",
    "preact": "^10.29.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "version": "1.10.0"
}
