{
  "name": "facturx-sdk",
  "version": "1.4.0",
  "description": "Pure TypeScript SDK to generate, embed, extract and validate Factur-X / ZUGFeRD invoices (EN 16931 profile) with the French BR-FR rules built in. No native dependencies; the ./pdf entry uses pdf-lib.",
  "license": "MIT",
  "author": "geekles007",
  "homepage": "https://facturx.ibird.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geekles007/facturx.git",
    "directory": "packages/facturx"
  },
  "bugs": {
    "url": "https://github.com/Geekles007/facturx/issues"
  },
  "keywords": [
    "factur-x",
    "facturx",
    "en16931",
    "cii",
    "zugferd",
    "pdf-a3",
    "e-invoicing",
    "facture-electronique",
    "reforme-facturation",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "saxon-js": "2.7.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "xslt3": "2.7.0"
  },
  "bin": {
    "facturx": "./dist/cli.js"
  },
  "peerDependencies": {
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "peerDependenciesMeta": {
    "@pdf-lib/fontkit": {
      "optional": true
    }
  }
}
